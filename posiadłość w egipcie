select id_filmu, tytul, rok_produkcji FROM filmy WHERE czas_trwania > 100;
zad2.
select imie, nazwisko, plik_awatara FROM aktorzy WHERE id_aktora = 3;
zad3.
SELECT * FROM aktorzy ORDER BY imie AND nazwisko ASC;
zad4. 
SELECT filmy.id_filmu, tytul, rok_produkcji FROM filmy INNER JOIN filmy_aktorzy on filmy.id_filmu = filmy_aktorzy.id_filmu INNER JOIN aktorzy on filmy_aktorzy.id_aktora = aktorzy.id_aktora WHERE aktorzy.id_aktora = 3;
zad5
SELECT aktorzy.id_aktora, COUNT(id_filmu) as liczba_filmow FROM aktorzy INNER JOIN filmy_aktorzy on aktorzy.id_aktora = filmy_aktorzy.id_aktora GROUP BY aktorzy.id_aktora;
